# Required unless the API key is passed directly to the Python API.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional defaults.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BATCH_MODEL=gemini-3.1-flash-image

# Optional cost estimates written to usage logs.
GEMINI_INPUT_COST_USD_PER_1M_TOKENS=0.30
GEMINI_OUTPUT_COST_USD_PER_1M_TOKENS=2.50
