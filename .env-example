# PDF Analyst — Environment Configuration
# Copy this file to .env and fill in your API key.

# ─────────────────────────────────────────────────────────────
# OpenAI (required — for GPT LLM + text-embedding-3-small)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# Default GPT model (used for LLM generation)
DEFAULT_MODEL=gpt-6-luna
Default_model= gpt-6-luna
# ─────────────────────────────────────────────────────────────
# Optional — Ollama (for local LLM fallback)
# ─────────────────────────────────────────────────────────────
# OLLAMA_HOST=http://localhost:11434

# Optional comma-separated models to offer in chat (DEFAULT_MODEL is always included).
CHAT_MODELS=

# ─────────────────────────────────────────────────────────────
# Production Infrastructure: Redis & SeaweedFS S3 Object Storage
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=seaweedfs
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=docuchat
S3_SECRET_KEY=docuchat-s3-development-secret
S3_BUCKET=docuchat-documents
S3_REGION=us-east-1

# ─────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────
JWT_SECRET=docuchat-production-secret-key-32bytes-minimum-security-token-2026
